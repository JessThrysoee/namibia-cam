{
  "name": "namibia-cam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-player": "3.4.0",
    "react-rnd": "10.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@rsbuild/core": "2.3.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-type-check": "1.6.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "npm-run-all2": "9.0.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "start": "run-s dev",
    "build": "rsbuild build",
    "dev": "rsbuild dev --open",
    "preview": "rsbuild preview",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "npm-check-updates": "npx --yes npm-check-updates@latest -i --format group"
  }
}
